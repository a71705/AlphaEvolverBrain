# .env.example - WorldQuant Alpha Evolution System 环境变量示例

# --- 应用基本配置 ---
# LOG_LEVEL: 应用的日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# ENVIRONMENT: 运行环境 (例如: development, staging, production)。可选，但有助于区分配置。
# ENVIRONMENT=development
# PYTHONUNBUFFERED: 设置为1可以确保Python的print和logging直接输出到stdout/stderr，对Docker日志有益。
PYTHONUNBUFFERED=1


# --- Redis 配置 ---
# REDIS_HOST: Redis 服务的主机名 (在 Docker Compose 中通常是服务名)
REDIS_HOST=redis
# REDIS_PORT: Redis 服务的端口号
REDIS_PORT=6379
# REDIS_DB: 使用的 Redis 数据库编号
REDIS_DB=0
# REDIS_URL: 完整的 Redis 连接 URL (FastAPI 应用和 RQ Worker 均使用此配置)
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}


# --- 数据库配置 ---
# DATABASE_URL: SQLAlchemy 数据库连接字符串。
# 对于 SQLite (路径相对于容器内 /app 目录，通过 volume 挂载到 ./data):
DATABASE_URL=sqlite:///./data/alpha_evolution.db
# 对于 PostgreSQL (示例，需要单独的 PostgreSQL 服务):
# POSTGRES_SERVER=postgres_db
# POSTGRES_USER=your_postgres_user
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_DB=your_postgres_db
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}/${POSTGRES_DB}


# --- WorldQuant Brain API 凭据 ---
# 必须填写这些凭据才能与 WorldQuant Brain API 交互。
# !!! 警告: 这些是敏感信息，不要将实际凭据提交到版本控制中。!!!
# !!! 在生产环境中，请使用安全的秘密管理方法 (如 Docker Secrets, Vault, 云服务商的 Secret Manager)。!!!
BRAIN_CREDENTIAL_EMAIL=your_brain_api_email@example.com
BRAIN_CREDENTIAL_PASSWORD=your_brain_api_password


# --- 邮件通知服务配置 (SMTP) ---
# 用于发送实验完成、错误等通知邮件。
# !!! 警告: EMAIL_PASSWORD 是敏感信息。!!!
SMTP_SERVER=smtp.example.com
SMTP_PORT=587 # 常用端口: 587 (STARTTLS), 465 (SSL/TLS), 25 (通常不加密，不推荐)
EMAIL_USERNAME=your_smtp_username@example.com # 您的邮箱账户用户名 (通常是完整邮箱地址)
EMAIL_PASSWORD=your_smtp_password_or_app_specific_token # 邮箱密码或应用专用密码/Token
# NOTIFICATION_EMAIL_SENDER: 可选的发件人邮箱地址。
# 如果留空或与 EMAIL_USERNAME 相同，则通常以 EMAIL_USERNAME 作为发件人。
# 注意: 某些邮件服务器可能要求发件人地址与认证用户一致。
NOTIFICATION_EMAIL_SENDER=
# DEFAULT_NOTIFICATION_RECIPIENT: 接收系统测试邮件或默认通知的邮箱地址。
DEFAULT_NOTIFICATION_RECIPIENT=your_notification_recipient@example.com


# --- RQ Dashboard 配置 ---
# RQ_REDIS_URL: RQ Dashboard 连接 Redis 所需的 URL。
# 通常在 docker-compose.yml 文件中为 rq-dashboard 服务直接设置，因为它直接引用 Docker Compose 网络中的 Redis 服务名。
# 如果需要通过 .env 文件配置，则可以取消注释下一行，并在 docker-compose.yml 中引用 ${RQ_REDIS_URL}。
# RQ_REDIS_URL=redis://redis:6379/0


# --- FastAPI 应用安全与密钥 ---
# SECRET_KEY: 用于保护会话、签名令牌等的密钥。
# !!! 警告: 这是非常敏感的信息。请生成一个长且高度随机的字符串。!!!
# 示例生成方法 (Linux/macOS): openssl rand -hex 32
# SECRET_KEY=your_very_long_and_random_secret_key_here
# ALGORITHM: JWT 签名算法 (如果使用JWT)。
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES: JWT 访问令牌的有效期（分钟）。
ACCESS_TOKEN_EXPIRE_MINUTES=30


# --- 其他可选配置 ---
# API_V1_STR: API 版本前缀 (如果需要在代码中动态引用)。
# API_V1_STR=/api/v1
# PROJECT_NAME: 项目名称，可能用于日志或元数据。
# PROJECT_NAME="WorldQuant Alpha Evolution System"
